# Every page is prerendered to static HTML at build time (scripts/prerender.mjs),
# so there is no SPA catch-all: unknown URLs get dist/404.html with a real 404
# status instead of a blank 200 "soft 404".

# Blog articles are prerendered at build time; ones published since the last
# build fall through to a shell page that loads the article client-side.
/blog/*  /blog/__shell.html  200
