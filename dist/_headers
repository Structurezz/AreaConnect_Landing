# Never cache the version probe or the SPA entry — this lets clients
# detect new deploys immediately on refresh / tab focus.
/version.json
  Cache-Control: no-store, max-age=0, must-revalidate

/index.html
  Cache-Control: no-store, max-age=0, must-revalidate

/
  Cache-Control: no-store, max-age=0, must-revalidate

# Hashed build assets are safe to cache aggressively (filename changes on new builds).
/assets/*
  Cache-Control: public, max-age=31536000, immutable
